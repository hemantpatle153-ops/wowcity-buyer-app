# Copy to .env.local (never commit real values)
EXPO_PUBLIC_API_URL=https://api.wowcity.in/api/v1/public
# 1 = serve built-in fixture data (no server needed)
EXPO_PUBLIC_MOCK=1
# 1 = show the map of nearby shops (Android also needs GOOGLE_MAPS_ANDROID_API_KEY)
EXPO_PUBLIC_ENABLE_MAP=0
EXPO_PUBLIC_PRIVACY_URL=https://wowcity.in/privacy
